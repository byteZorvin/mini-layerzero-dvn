{
  "name": "mini-layerzero-dvn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "bunVersion": "1.x",
  "scripts": {
    "build:ethereum": "forge build --root contracts/ethereum",
    "build:starknet": "scarb --manifest-path contracts/starknet/Scarb.toml build",
    "check": "bun run typecheck",
    "test:ethereum": "forge test --root contracts/ethereum -vv",
    "test": "bun test",
    "test:all": "bun test && bun run test:ethereum",
    "typecheck": "bun x tsc --noEmit",
    "deploy": "bun run src/cli.ts deploy",
    "deploy:reverse": "bun run src/cli.ts deploy-reverse",
    "configure": "bun run src/cli.ts configure",
    "dev:vercel": "vercel dev",
    "deliver": "bun run src/cli.ts deliver",
    "backfill": "bun run src/cli.ts backfill",
    "status": "bun run src/cli.ts status",
    "relay": "bun run src/cli.ts relay",
    "migrate-state": "bun run src/cli.ts migrate-state",
    "scheduler:dev": "wrangler dev --config cloudflare/wrangler.jsonc",
    "scheduler:deploy": "wrangler deploy --config cloudflare/wrangler.jsonc"
  },
  "dependencies": {
    "@layerzerolabs/protocol-starknet-v2": "1.2.21",
    "starknet": "9.4.2",
    "viem": "2.39.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "typescript": "6.0.3",
    "wrangler": "4.120.1"
  }
}
